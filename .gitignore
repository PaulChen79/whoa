# Private design docs. docs/agents/ and docs/adr/ are exceptions: they are
# written for contributors and their agents, so they belong in version control.
docs/*
!docs/agents/
!docs/adr/

# Build output
/bin/
/dist/
/whoa

# Environment and secrets
.env
.env.*
!.env.example

# whoa runtime state (Session logs, Verdicts, replay output)
.whoa/
*.whoa.jsonl

# Editors and OS
.DS_Store
.vscode/
.idea/

# Test and coverage
coverage.out
coverage.html
